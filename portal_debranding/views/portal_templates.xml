<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="brand_promotion_debrand" inherit_id="web.brand_promotion">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template
        id="portal_record_sidebar_debrand"
        inherit_id="portal.portal_record_sidebar"
    >
        <!-- 20.0: the title block is the first div.d-none of the sidebar -->
        <xpath
            expr="//a[contains(@href, 'utm_medium=portal')]/parent::div"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
