<odoo>
    <template
        id="purchase_brand_promotion_debrand"
        inherit_id="purchase.portal_my_purchase_order"
        priority="99"
    >
        <!-- "Want to import this document in Odoo?" -->
        <xpath
            expr="//div[@id='portal_connect_software_modal']//div[hasclass('modal-body')]/div[1]"
            position="replace"
        />
        <!-- "Not using Odoo?" -->
        <xpath
            expr="//div[@id='portal_connect_software_modal']//div[hasclass('modal-body')]/div[1]/h5"
            position="replace"
        >
            <h5>Want to import this document?</h5>
        </xpath>
        <!-- Links to the Odoo documentation and website -->
        <xpath
            expr="//div[@id='portal_connect_software_modal']//div[hasclass('modal-body')]/div[last()-1]/p"
            position="replace"
        >
            <p
            >Use the above REST URL to get structured data of the purchase order in UBL format.</p>
        </xpath>
        <!-- "You don't use a good CRM software? Start on Odoo" -->
        <xpath
            expr="//div[@id='portal_connect_software_modal']//div[hasclass('modal-body')]/div[last()]"
            position="replace"
        />
    </template>
</odoo>
